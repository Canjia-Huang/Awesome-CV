{
  "latex-workshop.latex.build.fromFolder": ".",
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",

  // Build the math-garden variant by default (Build / Ctrl+Alt+B and auto build
  // on save). `make` in a terminal still builds the plain build/cv.pdf.
  "latex-workshop.latex.recipe.default": "latexmk (garden)",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (garden)",
      "tools": ["awesome-cv-latexmk-garden"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "awesome-cv-latexmk-garden",
      "command": "latexmk",
      "args": ["cv-florilegium.tex"],
      "cwd": "%WORKSPACE_FOLDER%"
    }
  ],

  // The recipe compiles cv-florilegium.tex, so tell the extension to look for
  // build/cv-florilegium.pdf, its .log/.aux/.fls and .synctex.gz.
  "latex-workshop.latex.jobname": "cv-florilegium"
}
